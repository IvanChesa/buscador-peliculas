# Copia este archivo como .env.local y pega tu propia API key de OMDb.
# Consíguela gratis en https://www.omdbapi.com/apikey.aspx (plan FREE, 1000 peticiones/día).
#
# El prefijo VITE_ es OBLIGATORIO: Vite solo expone al navegador las variables
# que empiezan por VITE_. Sin el prefijo, import.meta.env no la vería.
VITE_OMDB_API_KEY=
